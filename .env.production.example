# Copy to .env.production (production server; `npm run deploy` uploads it). Never commit the real file.
# Generate secrets:  openssl rand -base64 32

# Domain served by Caddy (automatic HTTPS). Point the DNS A record to the server first.
DOMAIN=shop.example.com
ACME_EMAIL=you@example.com

APP_ENV=production
PUBLIC_SITE_URL=https://shop.example.com

INTEGRATION_BUS=kafka
KAFKA_TOPIC_PREFIX=nova

# First start on an empty database also loads db/seed.sql (roles, permissions, demo catalog).
# Set to false when you import an existing database instead.
SEED_ON_INIT=true

# Required in production (the app refuses to start without them). SESSION_SECRET ≥ 32 characters.
SESSION_SECRET=
SECRETS_MASTER_KEY=
SECRETS_KEY_VERSION=v1
CRON_SECRET=

# --- Continuous off-server backup (Litestream → S3 / Cloudflare R2 / any S3-compatible bucket) ---------------------
# Every database change is shipped within ~1 s; a new server restores itself on first start (docker-compose.prod.yml).
# Empty LITESTREAM_BUCKET = off (only the daily on-server copy in /data/backups remains).
# Cloudflare R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto, an R2 API token with
# "Object Read & Write" on this bucket only. AWS S3: leave the endpoint empty and set the bucket's region.
LITESTREAM_BUCKET=
LITESTREAM_PATH=nova
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# --- Error monitoring (Sentry or a Sentry-compatible service: GlitchTip, Bugsink) -------------------------------
# Project DSN from Settings › Client Keys. Empty = off. Server errors, render errors and browser errors are sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# --- Uptime alarm (heartbeat) ------------------------------------------------------------------------------------
# A check URL from healthchecks.io / Better Stack heartbeats / Uptime Kuma push. The scheduler pings it every
# 5 minutes while /api/health answers (and <url>/fail when it does not); no ping within the grace period = alarm,
# also when the whole server is down. Add an external HTTP check of https://<DOMAIN>/api/health as well.
HEARTBEAT_URL=
