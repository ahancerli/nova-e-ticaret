{
	"name": "nova-commerce",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.16"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"scheduler": "node scripts/scheduler.mjs",
		"db:setup": "node scripts/db.mjs init",
		"db:schema": "node scripts/db.mjs schema",
		"db:seed": "node scripts/db.mjs seed",
		"db:migrate": "node scripts/db.mjs migrate",
		"db:reset": "node scripts/db.mjs reset",
		"db:query": "node scripts/db.mjs exec --command",
		"db:import": "node scripts/db.mjs import",
		"db:backup": "node scripts/db.mjs backup",
		"db:from-wrangler": "node scripts/import-wrangler-state.mjs",
		"db:test": "python3 db/tests/test_schema.py",
		"admin:create": "node scripts/create-admin.mjs",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f app scheduler",
		"docker:admin": "docker compose exec app node scripts/create-admin.mjs",
		"deploy": "sh deploy/deploy.sh",
		"ai:health": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs scripts/ai-health.mjs",
		"deps:latest": "npx --yes npm-check-updates@latest -u && npm install",
		"test": "npm run db:test && npm run test:core && npm run test:runtime && npm run test:catalog && npm run test:identity && npm run test:storefront && npm run test:orders && npm run test:integrations && npm run test:reporting && npm run test:content && npm run test:accounts && npm run test:campaigns && npm run test:showcase && npm run test:audit && npm run test:ai && npm run test:mail && npm run test:payments && npm run test:providers && npm run test:bulk && npm run test:marketplaces && npm run test:reviews && npm run test:commerce && npm run test:consent && npm run test:captcha && npm run test:support && npm run test:services",
		"test:reviews": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/reviews.test.ts",
		"test:services": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/services.test.ts",
		"test:core": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/unit/core.test.ts",
		"test:runtime": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/unit/runtime.test.ts",
		"test:catalog": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/catalog.test.ts",
		"test:identity": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/identity.test.ts",
		"test:storefront": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/storefront.test.ts",
		"test:orders": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/orders.test.ts",
		"test:integrations": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/integrations.test.ts",
		"test:reporting": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/reporting.test.ts",
		"test:content": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/content.test.ts",
		"test:accounts": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/accounts.test.ts",
		"test:campaigns": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/campaigns.test.ts",
		"test:showcase": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/showcase.test.ts",
		"test:audit": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/audit.test.ts",
		"test:ai": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/ai.test.ts",
		"test:mail": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/mail.test.ts",
		"test:payments": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/payments.test.ts",
		"test:providers": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/providers.test.ts",
		"test:marketplaces": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/marketplaces.test.ts",
		"test:bulk": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/bulk.test.ts",
		"test:commerce": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/commerce.test.ts",
		"test:consent": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/consent.test.ts",
		"test:captcha": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/captcha.test.ts",
		"test:support": "node --no-warnings --experimental-transform-types --import ./tests/integration/register.mjs tests/integration/support.test.ts",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@ag-grid-community/locale": "^36.2.0",
		"ag-grid-community": "^36.2.0",
		"ag-grid-react": "^36.2.0",
		"bcryptjs": "^3.0.3",
		"graphql": "^17.0.2",
		"lucide-react": "^1.66.0",
		"next": "^16.4.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"server-only": "^0.0.1",
		"sonner": "^2.0.8",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.4.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	}
}
