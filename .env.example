# Copy to .env.local for local development (npm run dev, scripts, local `docker compose up`).
# Generate secrets:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

APP_ENV=development
PUBLIC_SITE_URL=http://localhost:3000

# SQLite file + uploaded media (Docker overrides both with /data/...)
DATABASE_PATH=data/nova.db
MEDIA_DIR=data/uploads

# Integration bus: "database" (SQLite tables) or "kafka" (Kafka REST proxy v2).
# With `docker compose up -d kafka kafka-rest`:  INTEGRATION_BUS=kafka  KAFKA_REST_URL=http://localhost:8082
INTEGRATION_BUS=database
KAFKA_TOPIC_PREFIX=nova

# 32+ random bytes, base64. HMAC for session/cart tokens and IP hashes.
SESSION_SECRET=
# 32 random bytes, base64. AES-GCM master key for integration_secrets (SMTP / AI / marketplace keys).
SECRETS_MASTER_KEY=
SECRETS_KEY_VERSION=v1
# Protects /api/cron/* (scheduler). Random string.
CRON_SECRET=
