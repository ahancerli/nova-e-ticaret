# Reverse proxy in front of the app (production only, docker-compose.prod.yml).
# Automatic HTTPS for {$DOMAIN} (Let's Encrypt). X-Real-IP = the TCP peer, overwriting anything the client sent;
# the app reads the client IP from it (rate limits, payment provider).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Live support streams (text/event-stream) stay uncompressed so every event is flushed at once.
	@compressible not path /api/storefront/support/stream /api/admin/support/stream
	encode @compressible zstd gzip
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
}
